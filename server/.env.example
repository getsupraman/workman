# Copy to server/.env and fill in. Read by `docker compose -f server/compose.yml`.
# Blank on purpose: compose refuses to start rather than boot with a guessable secret.

# The operator's sign-in for the dashboard at / (doc 08 §4); agents sign in with OAuth through it. Leave it
# unset and the auth is fail-closed, which means a login box that cannot succeed.
WORKMAN_DASHBOARD_USERNAME=
WORKMAN_DASHBOARD_PASSWORD=

# Optional. The address humans open the dashboard at, e.g. https://workman.example.lan — the base
# of the `web` link work_brief and work_get print. Blank means the host the agent's request came in
# on (http://127.0.0.1:5290 from this machine), which is right unless a proxy or another name is used.
WORKMAN_PUBLIC_URL=

# Optional. More origins the same server is reached on, comma-separated, e.g.
# https://workman.example.com,https://workman.example.org. Each is its own OAuth issuer and resource: a
# request is answered as the origin its host names, and a host that names none as the first one
# (WORKMAN_PUBLIC_URL when set). A token signed in at one origin works at that origin only.
WORKMAN_PUBLIC_URLS=

# Optional. Comma-separated IPs or CIDRs of the reverse proxy in front of the API, e.g. 172.18.0.0/16
# for a proxy on the same docker network. Only from these addresses are X-Forwarded-Proto/Host/For
# believed, so links and the dashboard cookie follow the https origin the proxy is reached on.
# Blank trusts nobody: the headers are never read, which is right when nothing sits in front.
WORKMAN_TRUSTED_PROXIES=

# Host port the API is published on.
WORKMAN_API_PORT=5290

# Host interface the API is published on. Loopback only by default: the dashboard and /mcp are then
# reachable from this machine alone. Set 0.0.0.0 only if you mean to expose it to your network.
WORKMAN_BIND=127.0.0.1

POSTGRES_DB=workman
POSTGRES_USER=workman
POSTGRES_PASSWORD=

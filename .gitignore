# Build output. plugin/skills/dotnet-source/tool is a real .NET project, so building or debugging it locally
# produces bin/obj here. The shipped artifact is the SOURCE — ds.ps1/ds.sh compile it on first use
# into a hash-keyed cache under the temp dir, so nothing built ever belongs in the repo.
bin/
obj/

# Orchestrator run artifacts (plans, ledgers, briefs for a single run) — not a team artifact.
.claude/orchestration/

# Rider / VS / VS Code
.vs/
.idea/
*.user
*.suo
*.DotSettings.user

# Nested-agent briefs (per-run, not a team artifact)
.claude/briefs/

# Filled-in secrets for server/compose.yml. server/.env.example is the committed template.
.env

# The setup script's copy of setup/assets/session-header.mjs in a clone install.
server/session-header.mjs

# Frontend. The SPA is built by an opt-in MSBuild target and by the Dockerfile's Node stage,
# so no build output belongs in the repo. wwwroot is entirely generated: the API serves a
# built-in placeholder when index.html is absent, so a clone without Node still runs.
server/frontend/node_modules/
server/frontend/dist/
server/Workman.Api/wwwroot/

# Python bytecode. The agents watchdog is a .py script the plugin ships; running it
# leaves a __pycache__ beside it, and a committed .pyc is both junk and interpreter-specific.
__pycache__/
*.pyc

# Scratch written by /workman:setup when it asks the server what tools a token grants.
# It runs from this repo root, so the file lands here; it is evidence for one command, not an artifact.
tools.json

# The commit-message path every brief in this repo mandates: `git commit -F server/.commit-msg.txt`.
# It is scratch for one commit, and it sat untracked-but-not-ignored, so every agent that used it
# left a file one `git add -A` away from being committed.
server/.commit-msg.txt
